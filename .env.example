# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# All banking data, credentials, biometric vaults, and sessions run 100% locally on the device.

# Web Push (VAPID) Configuration — run `node scripts/generate-vapid-keys.mjs` to generate keys
# If omitted locally, the server auto-generates and stores keys in data/vapid-keys.json.
VAPID_PUBLIC_KEY="MY_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="MY_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:notifications@cbemobile.app"

# Server-side HMAC & Admin Notification Security Secrets
AUTH_TOKEN_SECRET="MY_AUTH_TOKEN_SECRET"
NOTIFICATION_ADMIN_SECRET="MY_NOTIFICATION_ADMIN_SECRET"
