{
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"CBE-Mobil.apk\""
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/manifests/(.*)\\.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(sw-push\\.js|sw\\.js|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sms",
      "destination": "/sms/index.html"
    },
    {
      "source": "/sms/",
      "destination": "/sms/index.html"
    },
    {
      "source": "/truecaller",
      "destination": "/truecaller/index.html"
    },
    {
      "source": "/truecaller/",
      "destination": "/truecaller/index.html"
    },
    {
      "source": "/telebirr",
      "destination": "/telebirr/index.html"
    },
    {
      "source": "/telebirr/",
      "destination": "/telebirr/index.html"
    },
    {
      "source": "/dashen",
      "destination": "/dashen/index.html"
    },
    {
      "source": "/dashen/",
      "destination": "/dashen/index.html"
    },
    {
      "source": "/telegram",
      "destination": "/telegram/index.html"
    },
    {
      "source": "/telegram/",
      "destination": "/telegram/index.html"
    },
    {
      "source": "/phone",
      "destination": "/phone/index.html"
    },
    {
      "source": "/phone/",
      "destination": "/phone/index.html"
    },
    {
      "source": "/((?!api/|downloads/|assets/|icons/|manifests/|sms/|truecaller/|telebirr/|dashen/|telegram/|phone/|sw-push\\.js|sw\\.js|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
