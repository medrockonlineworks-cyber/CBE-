{
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"CBE-Mobil.apk\""
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/manifests/(.*)\\.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(sms|truecaller|phone)/sw-push\\.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(sw-push\\.js|sw\\.js|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/sync/state",
      "destination": "/api/bridge?route=/api/sync/state"
    },
    {
      "source": "/api/subapp/vapid-key",
      "destination": "/api/bridge?route=/api/subapp/vapid-key"
    },
    {
      "source": "/api/subapp/subscribe",
      "destination": "/api/bridge?route=/api/subapp/subscribe"
    },
    {
      "source": "/api/subapp/push",
      "destination": "/api/bridge?route=/api/subapp/push"
    },
    {
      "source": "/api/subapp/status",
      "destination": "/api/bridge?route=/api/subapp/status"
    },
    {
      "source": "/api/notifications/vapid-public-key",
      "destination": "/api/bridge?route=/api/notifications/vapid-public-key"
    },
    {
      "source": "/api/pwa/app-logo",
      "destination": "/api/bridge?route=/api/pwa/app-logo"
    },
    {
      "source": "/api/pwa/app-logos",
      "destination": "/api/bridge?route=/api/pwa/app-logos"
    },
    {
      "source": "/api/pwa/manifest",
      "destination": "/api/bridge?route=/api/pwa/manifest"
    },
    {
      "source": "/api/pwa/icon",
      "destination": "/api/bridge?route=/api/pwa/icon"
    },
    {
      "source": "/manifests/subapp-sms.webmanifest",
      "destination": "/api/bridge?route=/api/pwa/manifest&app=sms"
    },
    {
      "source": "/manifests/subapp-truecaller.webmanifest",
      "destination": "/api/bridge?route=/api/pwa/manifest&app=truecaller"
    },
    {
      "source": "/manifests/subapp-phone.webmanifest",
      "destination": "/api/bridge?route=/api/pwa/manifest&app=phone"
    },
    {
      "source": "/sms",
      "destination": "/sms/index.html"
    },
    {
      "source": "/sms/",
      "destination": "/sms/index.html"
    },
    {
      "source": "/truecaller",
      "destination": "/truecaller/index.html"
    },
    {
      "source": "/truecaller/",
      "destination": "/truecaller/index.html"
    },
    {
      "source": "/phone",
      "destination": "/phone/index.html"
    },
    {
      "source": "/phone/",
      "destination": "/phone/index.html"
    },
    {
      "source": "/((?!api/|downloads/|assets/|icons/|manifests/|sms/|truecaller/|phone/|sw-push\\.js|sw\\.js|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
