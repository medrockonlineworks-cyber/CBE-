<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:icon="@mipmap/ic_messages_launcher"
        android:roundIcon="@mipmap/ic_messages_launcher_round"
        android:label="@string/app_name"
        tools:replace="android:icon,android:roundIcon,android:label">

        <receiver
            android:name="et.cbe.tanadigitalbank.IncomingSmsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="et.cbe.messages.ACTION_INCOMING_SMS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="et.cbe.tanadigitalbank.MarkSmsReadReceiver"
            android:exported="false" />
    </application>
</manifest>
